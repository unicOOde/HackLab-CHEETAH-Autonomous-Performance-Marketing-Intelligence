digraph G {rankdir=TB;graph [fontname="DejaVu Sans",bgcolor="transparent",pad="0.17",nodesep="0.34",ranksep="0.42",splines=polyline];node[fontname="DejaVu Sans",fontsize=11,shape=box,style="rounded,filled",margin="0.18,0.12",penwidth=1.2,color="#B8C8D4",fillcolor="#F4F8FB",fontcolor="#173146"];edge[color="#6A8293",penwidth=1.2,arrowsize=0.7,fontname="DejaVu Sans",fontsize=9]; node[width=2.65];subgraph cluster_business {label="SOURCE + FINANCIAL LEDGER";style="rounded";color="#B6DAD3";source[label="Source Dataset\nVersion / Provenance",fillcolor="#DDEFEA",color="#158C80"];click[label="Click Events\nClick ID / Publisher / AdSpace"];inst[label="Install Transactions\nTransaction ID / Amount / Commission"];ledger[label="Daily Revenue Ledger\nBusiness Date / Net Amount / Completeness",fillcolor="#E4F1FC"];source->click;source->inst;inst->ledger;}subgraph cluster_run {label="RUN + FORECAST + EVIDENCE";style="rounded";color="#C6D8EA";run[label="Simulation Run\nSeed / Clock / Graph Version",fillcolor="#DDEFEA",color="#158C80"];forecast[label="Forecast Run / D+1 Reference\nPoint / Lower / Upper / Issue Day",fillcolor="#E4F1FC"];incident[label="Aggregate Incident\nReference / Direction / Lifecycle",fillcolor="#FCE7E8",color="#C15D64"];agent[label="Agent Tasks / Evaluation\nEvidence / Verdict / Fallback",fillcolor="#FFF2DB",color="#D39B38"];action[label="Action / Approval / Rollback\nPolicy / Execution / Verification",fillcolor="#FFF2DB",color="#D39B38"];outbox[label="Event Outbox / Audit\nEvent ID / Sim Time / Payload",fillcolor="#F3F1FD",color="#7B70AA"];run->forecast->incident->agent->action->outbox;} {rank=same;source;run;}ledger->incident[style=dashed,constraint=false];run->outbox[style=dotted,constraint=false];}