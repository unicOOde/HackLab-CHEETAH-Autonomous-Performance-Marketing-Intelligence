digraph G {rankdir=TB;graph [fontname="DejaVu Sans", bgcolor="transparent", pad="0.15", nodesep="0.34", ranksep="0.48", splines=ortho, outputorder="edgesfirst"]; node [fontname="DejaVu Sans", fontsize=10, shape=box, style="rounded,filled", penwidth=1.2, color="#C9D6DE", fillcolor="#F5F8FA", fontcolor="#173146", margin="0.16,0.11"]; edge [fontname="DejaVu Sans", fontsize=8.5, color="#6E8290", arrowsize=0.7, penwidth=1.15]; start[label="Load October run + locked reference for day D",fillcolor="#DDEFEA",color="#168A81"];release[label="Release eligible clicks / installs\nin simulated event-time order"];interim[label="Update provisional counters\n(stream via event outbox)"];close[label="Close day D and finalize Amount\nwith completeness / watermark rule"];check[label="Compare Amount(D) with frozen D-1 range",shape=diamond,fillcolor="#FFF2DB",color="#D39B38"];normal[label="Within interval / unavailable reference\nrecord classification and reason"];pause[label="Commit incident + checkpoint + PAUSE\n(no release of day D+1)",fillcolor="#FCE7E8",color="#C15D64"];invest[label="Investigator + Evidence Reviewer\ncontinue while clock is paused"];decision[label="Approval / sandbox action / replay decision"];next[label="Generate 7-day forecast from observations through D\nlock D+1 only; advance on allowed resume"];end[label="October 31 complete",fillcolor="#DDEFEA",color="#168A81"];start->release->interim->close->check;check->normal[label="within/missing"];check->pause[label="below/above"];pause->invest->decision->next;normal->next;next->release[label="D < Oct 31"];next->end[label="D = Oct 31"]; }