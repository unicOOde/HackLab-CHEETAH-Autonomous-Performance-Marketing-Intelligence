digraph G {rankdir=TB;graph [fontname="DejaVu Sans", bgcolor="transparent", pad="0.15", nodesep="0.34", ranksep="0.48", splines=ortho, outputorder="edgesfirst"]; node [fontname="DejaVu Sans", fontsize=10, shape=box, style="rounded,filled", penwidth=1.2, color="#C9D6DE", fillcolor="#F5F8FA", fontcolor="#173146", margin="0.16,0.11"]; edge [fontname="DejaVu Sans", fontsize=8.5, color="#6E8290", arrowsize=0.7, penwidth=1.15]; top[label="Global Simulation Toolbar\nRun ID • October date • Start/Pause/Speed • Replay • Connection",fillcolor="#DDEFEA",color="#168A81"];subgraph cluster_screens {label="Preserve six destinations";color="#BFD8D8";style="rounded";perf[label="01 Performance\n6 KPIs + aggregate chart"];fcast[label="02 Forecast\n7-day total outlook + live feed"];mon[label="03 Agentic Monitoring\nKanban + 2 graphs + Reviewer + Actions + Run compare",fillcolor="#E4F1FC",color="#4B79AA"];market[label="04 Marketplace\nneutral campaign lamp + country revenue"];reports[label="05 Reports\n5 tabs + provenance"];ctx[label="06 Context Explorer\nversioned graph"];} top->perf;top->fcast;top->mon;top->market;top->reports;top->ctx;perf->mon [style=dashed,label="incident link"];fcast->mon [style=dashed,label="deviation"];mon->ctx [style=dashed,label="graph focus"];mon->reports [style=dashed,label="evidence rows"];market->reports [style=dashed,label="country source"]; }