digraph G {rankdir=TB;graph [fontname="DejaVu Sans", bgcolor="transparent", pad="0.15", nodesep="0.34", ranksep="0.48", splines=ortho, outputorder="edgesfirst"]; node [fontname="DejaVu Sans", fontsize=10, shape=box, style="rounded,filled", penwidth=1.2, color="#C9D6DE", fillcolor="#F5F8FA", fontcolor="#173146", margin="0.16,0.11"]; edge [fontname="DejaVu Sans", fontsize=8.5, color="#6E8290", arrowsize=0.7, penwidth=1.15]; alert[label="Aggregate Amount anomaly (negative or positive)",fillcolor="#FCE7E8",color="#C15D64"];ctx[label="Investigator: read context + evidence\nNeo4j MCP / reports / telemetry"];known[label="Explanation supported?",shape=diamond,fillcolor="#FFF2DB",color="#D39B38"];react[label="Bounded ReAct fallback\nmax tool steps / time / cost",fillcolor="#FFF2DB",color="#D39B38"];review[label="Evidence Reviewer Agent\nconsiders alternatives & tests",fillcolor="#E4F1FC",color="#4B79AA"];grade[label="Verdict: supported / insufficient / contradicted / inconclusive",fillcolor="#F3F1FD",color="#7B70AA"];graphProposal[label="Graph change proposal\nprovisional + evidence refs"];approval[label="Human / policy approval gate",shape=diamond,fillcolor="#FFF2DB",color="#D39B38"];act[label="Sandbox Fix Action executor\nauthorize, execute, verify, rollback",fillcolor="#DDEFEA",color="#168A81"];noact[label="Recommendation / review only\nno unsupported spending changes"];audit[label="Immutable task, evidence, action & evaluation trail"];alert->ctx->known;known->review[label="yes"];known->react[label="no"];react->review;review->grade;grade->graphProposal;grade->approval;approval->act[label="authorized"];approval->noact[label="not authorized / positive case"];graphProposal->audit;act->audit;noact->audit; }