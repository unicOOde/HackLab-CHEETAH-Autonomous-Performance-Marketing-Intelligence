digraph G {rankdir=TB;graph [fontname="DejaVu Sans", bgcolor="transparent", pad="0.15", nodesep="0.34", ranksep="0.48", splines=ortho, outputorder="edgesfirst"]; node [fontname="DejaVu Sans", fontsize=10, shape=box, style="rounded,filled", penwidth=1.2, color="#C9D6DE", fillcolor="#F5F8FA", fontcolor="#173146", margin="0.16,0.11"]; edge [fontname="DejaVu Sans", fontsize=8.5, color="#6E8290", arrowsize=0.7, penwidth=1.15]; detected[label="Run A: October anomaly + frozen checkpoint",fillcolor="#FCE7E8",color="#C15D64"];done[label="Investigation + evidence review + approved changes"];branch[label="Which validation?",shape=diamond,fillcolor="#FFF2DB",color="#D39B38"];learn[label="LEARNING REPLAY — Run B\nSame anomaly / no fix / new approved graph",fillcolor="#E4F1FC",color="#4B79AA"];fix[label="FIX VALIDATION — Run C\nSame exogenous inputs / apply authorized fix",fillcolor="#DDEFEA",color="#168A81"];lm[label="Compare root cause, evidence, tool calls, latency\ntruth labels if available"];fm[label="Compare Amount, conversion, remaining deviations\nand action costs"];result[label="Separate evaluation reports\noriginal snapshots never overwritten",fillcolor="#F3F1FD",color="#7B70AA"];detected->done->branch;branch->learn[label="learning"];branch->fix[label="fix"];learn->lm->result;fix->fm->result; }